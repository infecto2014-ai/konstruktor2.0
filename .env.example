# Local application
PORT=5173
# Leave empty to use 127.0.0.1 in development and 0.0.0.0 in production.
HOST=
DATA_DIR=./data
ALLOWED_ORIGINS=http://localhost:5174
ORDER_TIME_ZONE=Europe/Kaliningrad

# Leave DATABASE_URL empty for built-in SQLite.
DATABASE_URL=
# Set to disable only when your PostgreSQL endpoint does not use TLS.
PGSSL=

# Local files are the default. For S3 set STORAGE_DRIVER=s3 and configure bucket/credentials.
STORAGE_DRIVER=local
S3_BUCKET=
AWS_REGION=us-east-1
S3_ENDPOINT=

# Used by docker-compose.yml for the optional local PostgreSQL service.
POSTGRES_DB=souvenir
POSTGRES_USER=souvenir
POSTGRES_PASSWORD=change-this-local-only

# Optional integration tests against a disposable PostgreSQL database.
PG_TEST_URL=
