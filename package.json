{
  "name": "souvenir-constructor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/main.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:pages": "tsc --noEmit && vite build --mode pages --base=/konstruktor2.0/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@fontsource/noto-sans": "^5.2.0",
    "@fontsource/noto-serif": "^5.2.0",
    "@fontsource/onest": "^5.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "fflate": "^0.8.3",
    "helmet": "^8.0.0",
    "multer": "^2.0.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
